#!/usr/bin/env bash
# Fusebase Flow — pre-commit git hook
# fusebase-flow-managed-hook: v1
#
#
#
# Bypass: NEVER use --no-verify. Real secret flagged => rotate + `git reset HEAD --
# <file>` to unstage; never whitelist it (disables a pattern globally, breaks the
# scanner's own fixtures 10/11). False positive => fix the pattern.
# Known scan-scope limits (docs/compatibility.md § Secret-scan): designed-token
# files are path-excluded; PreToolUse self-trips when an agent writes full
# secret-patterns.yml content.

set -uo pipefail

# 0. REPOSITORY-CONTEXT CLASSIFIER (A2; docs/specs/pre-commit-trusted-tool-contract/spec.md).
#    TRIPWIRE: an empty `--show-toplevel` means EITHER outside-a-repository OR git-unusable-INSIDE
#    one; both used to exit 0, skipping §2 (FR-12) + §3 (FR-07). Only independent `.git` evidence
#    separates them. FAULT detection only: a PATH-controlling caller can still supply a shim.
# TRIPWIRE: _ffpc_par stays ONE line (the G10 row extracts and evals it); POSIX + UNC only — any other form returns "" and TERMINATES the ascent, under-searching rather than mis-ascending.
_ffpc_par() { case "$1" in //*/*/*|/[!/]*/*) printf '%s' "${1%/*}" ;; /[!/]*) printf '/' ;; esac; }
_ffpc_block() {
    echo "[fusebase-flow:pre-commit] BLOCK — git resolved no worktree here, but $1. Failing closed: skipping would drop the FR-12 staged secret scan (§2) and the FR-07 protected-path check (§3) inside a repository. Repair git (or the declared context) and re-run. NEVER use --no-verify." >&2
    exit 1
}
# TRIPWIRE (T84): every git read in this hook writes to a FILE and is read back with shell
# builtins — NEVER `$(git …)`. A Windows-native git descendant can hold the write end of a
# command-substitution pipe open past exit, so the substitution never sees EOF and the hook
# hangs (docs/problem-catalog/msys-git-command-substitution-hang/). Gated by
# hooks/local/check-git-capture.sh; a new `$(git …)` here fails the git-capture-guard phase.
FFPC_SHIM_DIR=""
FFPC_GITCAP=""
FFPC_VD=""
_ffpc_cleanup() {
    [ -n "$FFPC_SHIM_DIR" ] && rm -rf "$FFPC_SHIM_DIR" 2>/dev/null
    [ -n "$FFPC_VD" ] && rm -rf "$FFPC_VD" 2>/dev/null
    [ -n "$FFPC_GITCAP" ] && rm -f "$FFPC_GITCAP" 2>/dev/null
    return 0
}
trap _ffpc_cleanup EXIT
FFPC_GITCAP="$(mktemp 2>/dev/null || mktemp -t ffflow-gitcap)"
if [ -z "$FFPC_GITCAP" ] || ! { : > "$FFPC_GITCAP"; } 2>/dev/null; then
    echo "[fusebase-flow:pre-commit] BLOCK — no writable temp file for the git reads §2/§3 depend on — failing closed. NEVER use --no-verify." >&2
    exit 1
fi
_ffpc_git_read() {   # CMD… -> stdout in $FFPC_GITCAP, rc in FFPC_GIT_RC (no pipe anywhere)
    : > "$FFPC_GITCAP" 2>/dev/null
    "$@" > "$FFPC_GITCAP" 2>/dev/null; FFPC_GIT_RC=$?
}
_ffpc_git_line() {   # CMD… -> first output line in FFPC_GIT_OUT via the `read` BUILTIN
    _ffpc_git_read "$@"
    FFPC_GIT_OUT=""
    IFS= read -r FFPC_GIT_OUT < "$FFPC_GITCAP" 2>/dev/null || :   # rc1 on EOF/partial line still sets it
}
_ffpc_git_line git rev-parse --show-toplevel
ROOT="$FFPC_GIT_OUT"
if [ -z "$ROOT" ]; then
    git rev-parse --git-dir >/dev/null 2>&1 && { echo "[fusebase-flow:pre-commit] a git repository without a worktree here (bare, or invoked inside .git/); no staged worktree content to check; skipping" >&2; exit 0; }
    [ -n "${GIT_DIR:-}${GIT_WORK_TREE:-}" ] && _ffpc_block "the environment declares repository context (GIT_DIR/GIT_WORK_TREE) that git could not resolve"
    # TRIPWIRE: strict-parent ascent, each candidate once — stop BEFORE a ceiling entry, before a
    # mount change unless GIT_DISCOVERY_ACROSS_FILESYSTEM, at the root _ffpc_par reports. NO stat
    # binary disables the mount stop (search runs FURTHER, erring toward BLOCK); a stat that EXISTS
    # and FAILS is indeterminate and blocks — never merge those. Device anchors to the STARTING dir.
    # TRIPWIRE: bare evidence needs `bare = true` — a merely bare-LOOKING layout is not evidence, because newly blocking a commit that works today is the worse outcome.
    FFPC_D="$(pwd -P 2>/dev/null)"; FFPC_DEV0=""; FFPC_NOSTAT=""; FFPC_CEIL=":$(printf %s "${GIT_CEILING_DIRECTORIES:-}" | tr ';' ':'):"
    command -v stat >/dev/null 2>&1 || FFPC_NOSTAT=1
    while [ -n "$FFPC_D" ]; do
        case "$FFPC_CEIL" in *":$FFPC_D:"*|*":$FFPC_D/:"*) break ;; esac
        FFPC_DEV="$(stat -c %d "$FFPC_D" 2>/dev/null || stat -f %d "$FFPC_D" 2>/dev/null)"
        [ -n "$FFPC_DEV$FFPC_NOSTAT" ] || _ffpc_block "'$FFPC_D' could not be stat'd, so repository context is indeterminate"
        [ -n "$FFPC_DEV0" ] || FFPC_DEV0="$FFPC_DEV"
        [ "$FFPC_DEV" = "$FFPC_DEV0" ] || [ -n "${GIT_DISCOVERY_ACROSS_FILESYSTEM:-}" ] || break
        [ -L "$FFPC_D/.git" ] && [ ! -e "$FFPC_D/.git" ] && _ffpc_block "'$FFPC_D/.git' is a dangling symlink, so repository context is indeterminate"
        [ -e "$FFPC_D/.git" ] && _ffpc_block "'$FFPC_D' carries repository evidence (a .git entry)"
        [ -d "$FFPC_D/objects" ] && [ -d "$FFPC_D/refs" ] && grep -Eq '^(ref: refs/|[0-9a-f]{40}$)' "$FFPC_D/HEAD" 2>/dev/null && grep -Eqi '^[[:space:]]*bare[[:space:]]*=[[:space:]]*true' "$FFPC_D/config" 2>/dev/null && _ffpc_block "'$FFPC_D' carries repository evidence (a bare repository layout)"
        FFPC_D="$(_ffpc_par "$FFPC_D")"
    done
    echo "[fusebase-flow:pre-commit] not in a git repo; skipping" >&2
    exit 0
fi

cd "$ROOT" || exit 0
FFVE_ORIGINAL_PATH="$PATH"

# ENV SANITIZATION (T30, security floor): scrub every python-influencing env var ONCE,
# before any python invocation below. ANY python call running with a mutable/inherited
# PYTHONPATH/startup surface is a sitecustomize-injection point: an attacker who exports
# `PYTHONPATH=$ROOT/hooks` + drops an untracked hooks/sitecustomize.py can run
# `os._exit(0)` (or forge a verdict file) at interpreter startup, BEFORE any check.
# T29 hardened §2/§3 with `-S`, but the §3 PREP step inherited PYTHONPATH and ran plain
# python3 — the live PoC bypass. Unsetting these here means no inherited value reaches
# ANY python invocation; each invocation additionally passes `-S` + an explicit,
# trusted-only PYTHONPATH (defense in depth). PYTHONNOUSERSITE=1 also blocks the user
# site-dir startup path even for any incidental non-`-S` python a sub-tool might spawn.
# PYTHONSAFEPATH=1 (T32, defense-in-depth): on Python 3.11+ the interpreter NEVER prepends
# the script dir / CWD / '' to sys.path, so a `python3 -S -` (stdin) heredoc can no longer
# import a repo-root pathlib.py/yaml.py shadow ahead of stdlib/site. Harmless/ignored on
# <3.11. Belt-and-suspenders with the primary T32 fix (§2/§3 mains now run as FILE scripts
# from the trusted temp dir, whose script-dir is the trusted dir and never the CWD).
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME 2>/dev/null || true
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1

SECRETS_REGEX='\.env$|\.env\.[^\.]*$|credentials\.json$|/secrets/|\.pem$|\.key$|\.netrc$'
_ffpc_git_read git diff --cached --name-only --diff-filter=ACM
SECRET_HITS="$(grep -E "$SECRETS_REGEX" < "$FFPC_GITCAP" || true)"
if [ -n "$SECRET_HITS" ]; then
    echo "[fusebase-flow:pre-commit] BLOCK — secret-like files staged:" >&2
    echo "$SECRET_HITS" | sed 's/^/  /' >&2
    echo "Per FR-12: never commit secrets. Unstage with \`git reset HEAD -- <file>\` and rotate if leaked." >&2
    exit 1
fi

# 1b. INTERPRETER CONTRACT (MAJOR 12) — ONE fail-closed rule covering BOTH §2 and §3.
#     final-architecture-review finding 12: "the scanner runs on every commit" — step 3's stated
#     justification for moving the secret-scan scenario phase out of the local default — was
#     FALSE without python3. §2 was wrapped in `if command -v python3` with NO else (the content
#     scan silently did not happen) and §3 printed a WARN and committed anyway (FR-07 not
#     enforced). Both are security controls; neither may depend on an interpreter being reachable
#     under the literal name python3. So §1b discovers a supported one under the other common names
#     (`python`, `py -3`) and puts a `python3` shim on PATH for this hook's lifetime — the same
#     provisioning the CI workflow already does. It changes no committed default and relaxes no
#     check; every invocation below still runs `python3 -S <file>` with a controlled PYTHONPATH.
#     If NOTHING supported is found, the commit is BLOCKED with a fixable message. There is no
#     env override: an override is the fail-open branch this replaces.
#     Scoped to commits that actually stage something — an empty staged set has nothing to
#     protect. Git still runs this hook for one (`git commit --amend` that only rewords, and
#     `--allow-empty`), so §2, §3, §4 and §4b check staged content only and skip it too: none of
#     them may run a python3 this section did not probe (T271; Windows' Store shortcut).
_ffpc_git_read git diff --cached --name-only; STAGED_ANY_RC=$FFPC_GIT_RC
STAGED_ANY=""; [ -s "$FFPC_GITCAP" ] && STAGED_ANY=1
if [ "$STAGED_ANY_RC" -ne 0 ]; then
    echo "[fusebase-flow:pre-commit] BLOCK — could not list staged changes (git rc=$STAGED_ANY_RC) — failing closed." >&2
    echo "Refusing to commit fail-open on an unverifiable staged set; NEVER use --no-verify." >&2
    exit 1
fi

# 1b-v. PRIMARY-INTERPRETER VERSION SYMMETRY (S2d; docs/specs/pre-commit-trusted-tool-contract/).
#     §1b probed only the DISCOVERED fallbacks, so a resolved `python3` reached §2/§3 unversioned.
#     TRIPWIRE: `-S -c` support is NOT a consumer requirement — a wrapper honouring only
#     `-S <file>` must keep working, so an unusable `-c` falls through to the file probe.
_ffpc_bounded() {   # <secs> <out> <err> <mark> CMD… — rc 124 == killed at the bound
    local s=$1 o=$2 e=$3 m=$4 p w r t f nap=0 monitor=0; shift 4; rm -f "$m" 2>/dev/null
    f="$m.fifo"
    if mkfifo "$f" 2>/dev/null && { exec 8<>"$f"; } 2>/dev/null; then nap=1; fi
    rm -f "$f" 2>/dev/null
    case $- in *m*) monitor=1 ;; esac
    set -m; t=$SECONDS; "$@" >"$o" 2>"$e" & p=$!; [ "$monitor" -eq 1 ] || set +m
    # TRIPWIRE: a timed built-in read avoids MSYS spawn delay; the FIFO is open read/write so EOF
    # cannot return early. Unsupported hosts use the one-spawn fallback at the same deadline.
    ( if [ "$nap" -eq 1 ]; then read -t "$((s - 1))" -u 8 _ 2>/dev/null || true
      else sleep "$((s - 1))"; fi
      kill -0 $p 2>/dev/null || exit 0
      printf '%s %s\n' "$((s - 1))" "$((SECONDS - t))" > "$m"
      kill -9 -- "-$p" 2>/dev/null || kill -9 "$p" 2>/dev/null ) >/dev/null 2>&1 & w=$!
    wait $p; r=$?; kill $w 2>/dev/null; wait $w 2>/dev/null
    [ "$nap" -eq 0 ] || { exec 8<&- 8>&-; }
    FFPC_BOUND_RETURN=$((SECONDS - t)); FFPC_BOUND_DEADLINE=none; FFPC_BOUND_SIGNAL=none
    if [ -f "$m" ]; then
        r=124; read -r FFPC_BOUND_DEADLINE FFPC_BOUND_SIGNAL < "$m"
        FFPC_BOUND_DEADLINE="${FFPC_BOUND_DEADLINE}s"; FFPC_BOUND_SIGNAL="${FFPC_BOUND_SIGNAL}s"
    fi
    return $r
}
_ffpc_ver() {   # <candidate> <probe args…>: one bounded probe; sets FFPC_VER (maj.min; empty = unproven), appends FFPC_DIAG
    # TRIPWIRE: 2>/dev/null hides only the SHELL's "Killed" job report; the probe's own stderr is
    # captured in $FFPC_VD/e and replayed in the BLOCK diagnostic — never discard it.
    local c=$1; shift
    # shellcheck disable=SC2086  # the candidate "py -3" is two words
    _ffpc_bounded 10 "$FFPC_VD/o" "$FFPC_VD/e" "$FFPC_VD/m" $c -S "$@" 2>/dev/null; local r=$?
    FFPC_VER="$(sed -n 's/^FFPCVER \([0-9][0-9]*\) \([0-9][0-9]*\)$/\1.\2/p' "$FFPC_VD/o" 2>/dev/null | head -1)"
    FFPC_DIAG="$FFPC_DIAG [$c -S ${1##*/} rc=$r$([ $r -eq 124 ] && printf ' TIMEOUT@10s') deadline=${FFPC_BOUND_DEADLINE} signal=${FFPC_BOUND_SIGNAL} return=${FFPC_BOUND_RETURN}s] $(tr '\r\n' '  ' < "$FFPC_VD/e" 2>/dev/null | cut -c1-160)"
}
_ffpc_try() {   # <candidate>: 0 when it proves 3.10+ by the `-S -c` probe, else by the `-S <file>` one
    command -v "${1%% *}" >/dev/null 2>&1 || { FFPC_VER=""; FFPC_DIAG="$FFPC_DIAG [$1: not found]"; return 1; }
    FFPC_VER=""
    _ffpc_ver "$1" -c "$FFPC_VSRC"
    [ -n "$FFPC_VER" ] || _ffpc_ver "$1" "$FFPC_VD/v.py"
    [ -n "$FFPC_VER" ] && { [ "${FFPC_VER%%.*}" -gt 3 ] || { [ "${FFPC_VER%%.*}" -eq 3 ] && [ "${FFPC_VER##*.}" -ge 10 ]; }; }
}
_ffpc_shim() {   # <why>: a python3 shim that runs $FFPC_FOUND, first on PATH for this hook's lifetime
    FFPC_SHIM_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t ffflow-py3)"
    if [ -z "$FFPC_SHIM_DIR" ] || ! printf '#!/usr/bin/env bash\nexec %s "$@"\n' "$FFPC_FOUND" > "$FFPC_SHIM_DIR/python3" 2>/dev/null; then
        echo "[fusebase-flow:pre-commit] BLOCK — found '$FFPC_FOUND' but could not provision a python3 shim — failing closed. NEVER use --no-verify." >&2
        exit 1
    fi
    chmod +x "$FFPC_SHIM_DIR/python3" 2>/dev/null
    PATH="$FFPC_SHIM_DIR:$PATH"; export PATH
    echo "[fusebase-flow:pre-commit] note: $1; using discovered '$FFPC_FOUND' for §2/§3 (shim is temporary, this commit only)." >&2
}
# O-19 (6.0.0-m4): python3, then python, then py -3, each through the probe above — the order commit-msg and
# the approval scripts use. A python3 that fails it falls through: on a stock Windows host with python.org's
# Python, the default App execution aliases resolve python3 to the Microsoft Store shortcut
# (…/WindowsApps/python3), which prints "Python was not found" and exits 49.
FFPC_FOUND=""; FFPC_DIAG=""; FFPC_PY3=""; FFPC_PY3_VER=""
FFPC_VSRC='import sys; print("FFPCVER %d %d" % sys.version_info[:2])'
FFPC_WAYOUT="On Windows, when python3 or python is the Microsoft Store shortcut (…/WindowsApps/), turn off the python.exe and python3.exe App execution aliases (Settings > Apps > Advanced app settings > App execution aliases), or install Python 3.10+ and put it on PATH; then re-run the commit. NEVER use --no-verify."
if [ -n "$STAGED_ANY" ]; then
    FFPC_VD="$(mktemp -d 2>/dev/null || mktemp -d -t ffflow-pyver)"
    [ -d "${FFPC_VD:-/nonexistent}" ] || { echo "[fusebase-flow:pre-commit] BLOCK — no temp dir for the python3 version probe — failing closed. NEVER use --no-verify." >&2; exit 1; }
    printf '%s\n' "$FFPC_VSRC" > "$FFPC_VD/v.py"
    if command -v python3 >/dev/null 2>&1; then
        FFPC_PY3="$(command -v python3)"
        _ffpc_try python3 || FFPC_PY3_VER="${FFPC_VER:-unproven}"
    fi
    if [ -z "$FFPC_PY3" ] || [ -n "$FFPC_PY3_VER" ]; then
        if _ffpc_try python; then FFPC_FOUND="python"
        elif _ffpc_try "py -3"; then FFPC_FOUND="py -3"
        fi
    fi
    rm -rf "$FFPC_VD"
fi

if [ -n "$FFPC_PY3_VER" ] && [ -z "$FFPC_FOUND" ]; then
    echo "[fusebase-flow:pre-commit] BLOCK — the resolved 'python3' ($FFPC_PY3) did not prove Python 3.10+ (version=$FFPC_PY3_VER), and neither python nor py -3 did; probes:$FFPC_DIAG" >&2
    echo "§2 (FR-12 staged secret scan) and §3 (FR-07 protected-path check) both run under it, so this commit is refused rather than run on an unsupported interpreter. $FFPC_WAYOUT" >&2
    exit 1
fi
case "$FFPC_PY3" in *[/\\]WindowsApps[/\\]*) FFPC_PY3="$FFPC_PY3, the Microsoft Store shortcut" ;; esac
[ -z "$FFPC_PY3_VER" ] || [ -z "$FFPC_FOUND" ] || _ffpc_shim "python3 ($FFPC_PY3) failed the 3.10+ probe (version=$FFPC_PY3_VER)"

if [ -n "$STAGED_ANY" ] && [ -z "$FFPC_PY3" ]; then
    if [ -z "$FFPC_FOUND" ]; then
        echo "[fusebase-flow:pre-commit] BLOCK — no supported Python 3.10+ interpreter found (tried: python3, python, py -3)." >&2
        echo "Two security controls need one: the FR-12 staged secret scan (§2) and the FR-07 protected-path check (§3). Neither can run, so this commit is refused rather than committed unscanned and unenforced." >&2
        echo "$FFPC_WAYOUT" >&2
        exit 1
    fi
    _ffpc_shim "python3 was not on PATH"
fi

# Stage timings (docs/changes/2026-10-15-v511-consumer-review.md O2): report-only, never a gate.
# TRIPWIRE: builtins only — a `date` spawn costs ~1 s on MSYS, and this file is git-capture gated.
# _ffpc_now stays ONE line (validator-evidence extracts and evals it) and strips EVERY non-digit:
# some locales print EPOCHREALTIME with a decimal comma.
_ffpc_now() { local t="${EPOCHREALTIME:-}"; t="${t//[!0-9]/}"; if [ -n "$t" ]; then FFPC_NOW_US=$((10#$t)); else FFPC_NOW_US=$((SECONDS * 1000000)); fi; }
_ffpc_stage() {
    local start=$FFPC_MARK_US us; _ffpc_now; FFPC_MARK_US=$FFPC_NOW_US
    us=$((FFPC_NOW_US - start)); [ "$us" -ge 0 ] || us=0
    printf '[fusebase-flow:pre-commit] stage=%s elapsed=%d.%02ds\n' "$1" $((us / 1000000)) $((us % 1000000 / 10000)) >&2
}
_ffpc_now; FFPC_MARK_US=$FFPC_NOW_US

# 2. Secret content scan (FR-12): ONLY added (+) lines, designed-token files path-excluded
#    (D-A1 — secret-patterns.yml self-trip + whitelist trap). scan() semantics UNCHANGED
#    (hooks/tests/fixtures 10/11 call scan() directly).
#
#    TRUSTED-HEAD SECRET SCANNER (T31, UNCONDITIONAL): the scanner CODE
#    (staged_secret_scan.py + secret_scanner.py + its shared deps) AND its patterns data
#    (policies/secret-patterns.yml) are THEMSELVES fusebase_flow_internals — the mutable
#    working tree cannot be trusted to run its own secret gate. T29/T30 added `-S` + an
#    env scrub (no startup-file / inherited-PYTHONPATH injection), but the SCRIPT + its
#    PATTERNS were still the working tree: an UNSTAGED tamper of staged_secret_scan.py
#    (make it `return 0`) OR of secret-patterns.yml (empty `patterns:`) => "no secrets"
#    => a real secret in the staged changeset commits unguarded. Same mutable-Python-load
#    class as the §3 self-tamper (T28-T30), applied to the secret scanner. Closed here by
#    running §2 from the COMMITTED (HEAD) scanner + patterns, extracted into a temp package
#    and imported under `-S` with an isolated PYTHONPATH (the trusted temp dir, never
#    $ROOT/hooks). It scans the STAGED changeset (git diff --cached — unchanged; the
#    content being committed). The env is already scrubbed at the hook top (T30).
#    GIT-BASED TRUSTED-vs-FALLBACK (shell-decided, like §3/T30): if HEAD carries the
#    scanner => ALWAYS trusted (a working-tree tamper cannot run). Fall back to the
#    working-tree scanner (under `-S`, with a note) ONLY when git proves HEAD genuinely
#    LACKS it (true first-adoption). A transient git error => fail closed.
if [ -n "$STAGED_ANY" ] && command -v python3 >/dev/null 2>&1; then
    # SEC_IMPORT_DIR = where the scanner `shared` package is imported from;
    # SEC_TRUSTED_PATTERNS = the trusted patterns yaml to seed the loader cache with
    # (empty => bootstrap fallback, scanner reads the working-tree patterns).
    SEC_IMPORT_DIR="$ROOT/hooks"
    SEC_TRUSTED_PATTERNS=""
    SEC_TMP=""
    # Sentinels: the scanner code + its patterns data. The SHELL decides trusted-vs-fallback
    # via `git ls-tree HEAD` (unforgeable — no python/startup file can influence it). rc0+
    # non-empty => present; rc0+empty => genuinely absent (first-adoption); rc!=0 => transient
    # git error => fail closed. (staged_secret_scan -> secret_scanner -> {audit_logger,
    # policy_loader}; policy_loader reads secret-patterns.yml.)
    SEC_SENTINELS="hooks/shared/__init__.py hooks/shared/staged_secret_scan.py hooks/shared/secret_scanner.py hooks/shared/audit_logger.py hooks/shared/policy_loader.py policies/secret-patterns.yml"
    SEC_DECISION="trusted"
    # T32 (RELIABILITY #3, MSYS): the sentinel `git ls-tree HEAD` is captured via a FILE
    # REDIRECT, NOT `$(git ls-tree ...)` command substitution. On MSYS/Git-Bash a
    # Windows-native git grandchild can hold the captured pipe open past exit, hanging the
    # parent shell (rc=124) — the documented $(...)+git freeze that was the source of the
    # gate timeouts. This is fail-SAFE (a hung hook only ever BLOCKS), not a security
    # change; the trusted-vs-fallback semantics are IDENTICAL (rc!=0 => fail closed; rc0+
    # empty => first-adoption fallback). Uses the same file-redirect pattern the PREP
    # extractor already relies on. The scratch file lives in SEC_LSFILE.
    SEC_LSFILE="$(mktemp 2>/dev/null || mktemp -t ffflow-secls)"
    if ! git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
        SEC_DECISION="fallback"
        echo "[fusebase-flow:pre-commit] note: no HEAD yet (first-adoption bootstrap) — §2 secret scan uses the working-tree scanner for this initial commit." >&2
    else
        for _s in $SEC_SENTINELS; do
            git ls-tree HEAD -- "$_s" > "$SEC_LSFILE" 2>/dev/null; _sls_rc=$?
            _sls="$(cat "$SEC_LSFILE" 2>/dev/null)"
            if [ "$_sls_rc" -ne 0 ]; then
                rm -f "$SEC_LSFILE"
                echo "[fusebase-flow:pre-commit] BLOCK — §2 secret scan could not read the trusted HEAD copy of $_s (transient git error, rc=$_sls_rc) — failing closed, NOT falling back to the untrusted working tree. NEVER use --no-verify." >&2
                exit 1
            fi
            if [ -z "$_sls" ]; then
                SEC_DECISION="fallback"
                echo "[fusebase-flow:pre-commit] note: $_s not in HEAD (first-adoption bootstrap) — §2 secret scan uses the working-tree scanner for this commit." >&2
                break
            fi
        done
    fi
    rm -f "$SEC_LSFILE"
    # T32 (primary CWD-strip fix): create the scratch/trusted temp dir UNCONDITIONALLY. The
    # §2 MAIN check now runs as a FILE SCRIPT from this dir (python3 -S "$SEC_TMP/_main_secret.py"),
    # so sys.path[0] is the trusted temp dir — NOT the repo-root CWD, which `-S -` (stdin) would
    # otherwise leave on sys.path[0] and let a repo-root pathlib.py/yaml.py shadow win before any
    # scrub. On the TRUSTED path the extractor also fills shared/+policies/ here; on the FALLBACK
    # path the dir holds ONLY the wrapper (SEC_IMPORT_DIR stays $ROOT/hooks, inserted by the wrapper).
    SEC_TMP="$(mktemp -d 2>/dev/null || mktemp -d -t ffflow-secret)"
    if [ "$SEC_DECISION" = "trusted" ]; then
        # Pure extractor (git show HEAD -> temp; no verdict). Written to a file, not a
        # heredoc-in-$(...) (bash -n here-doc parse). Fail closed on any git-show failure.
        cat > "$SEC_TMP/_prep_secret.py" <<'SECPREP'
import os, subprocess, sys
from pathlib import Path

root = Path(os.environ["ROOT"])
tmp = Path(os.environ["SEC_TMP"])

# The SHELL has already proven (git ls-tree) every one of these is present in HEAD; this
# script only EXTRACTS the trusted bytes. secret-patterns.local.yml is an OPTIONAL,
# gitignored designed-token override (never in HEAD) — deliberately NOT extracted; the
# trusted-patterns seed below binds the loader to ONLY HEAD's committed patterns.
files = [
    ("hooks/shared/__init__.py",            tmp / "shared" / "__init__.py"),
