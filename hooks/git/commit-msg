#!/usr/bin/env bash
# Fusebase Flow — commit-msg git hook (6.0)
# fusebase-flow-managed-hook: v1
#
# Rules 1 and 2 (FR-01, FR-03) on the subject: exactly one T<n>, resolved in docs/flow/phases.md at HEAD; `plan:` and
# `ship:` only on a commit of the four documents and the state files their skills name; the trivial tier from
# policies/evidence-classes.yml at HEAD (handoff WP 10, decision 10(c)). The checks live in
# hooks/local/lib/commit_msg.py. 6.0 only: 5.x keeps its own commit-msg (owner, 2026-10-19).
#
# Install: bash hooks/local/install-git-hooks.sh
#
# Original Fusebase Flow content; clean-room.

set -uo pipefail

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

# TRIPWIRE: git runs this hook from the top of the work tree, so the helper path is relative; its successor ships
# with the hook, and a missing one blocks rather than letting every subject through.
HELPER="hooks/local/lib/commit_msg.py"
if [ ! -f "$HELPER" ]; then
    echo "[fusebase-flow:commit-msg] BLOCK — $HELPER is missing, so the subject cannot be checked. Restore it: git checkout HEAD -- $HELPER (or re-run the Flow install). NEVER use --no-verify." >&2
    exit 1
fi
# The interpreter in the pre-commit's order: python3, then python, then py -3, each proved 3.10+ by the pre-commit's
# probe (O-19). A python.org Windows host has python and py but no python3; the Store stub fails the probe.
_ffcm_is_py3() { "$@" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 10) else 1)' >/dev/null 2>&1; }
FFCM_PY=""
for FFCM_TRY in python3 python "py -3"; do
    # shellcheck disable=SC2086  # "py -3" is two words
    if _ffcm_is_py3 $FFCM_TRY; then FFCM_PY="$FFCM_TRY"; break; fi
done
if [ -z "$FFCM_PY" ]; then
    echo "[fusebase-flow:commit-msg] BLOCK — no Python 3.10+ found (tried: python3, python, py -3), so the subject cannot be checked. Install Python 3.10+, then: python -m pip install -r hooks/requirements.txt; NEVER use --no-verify." >&2
    exit 1
fi
# shellcheck disable=SC2086
PYTHONPATH="" $FFCM_PY -E "$HELPER" "$MSG_FILE"
