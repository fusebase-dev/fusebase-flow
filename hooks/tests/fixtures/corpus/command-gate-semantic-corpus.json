  "schema_version": 1,
  "corpus_id": "command-gate-semantic-corpus",
  "ticket": "docs/backlog/command-gate-shell-evasion/README.md",
  "authority": "docs/specs/backlog-triage-execution/execution-plan.md §3 P8 + §4 S4 — corpus and decision record ONLY; no parser, policy or matching-logic patch is authorized by T5.",
  "driver": "hooks/tests/test-command-policy.sh § T5 reporting matrix",
  "location_note": "Deliberately in fixtures/corpus/, NOT fixtures/ — run_hook_tests.py:124 globs fixtures/*.json and FAILs any file without `_handler` (v4.2.1 coverage guard + EXPECTED_HANDLER_FIXTURES floor). This file is data, not a handler payload. hooks/tests/lib/* sits outside the hook-layer manifest for the same reason; the managed-content manifest (rglob hooks/) covers both.",
  "reading": "should_gate is the SEMANTIC verdict: does the shell, executing this exact string, perform the gated action? It is NOT a claim about today's regex. The driver records today's verdict per case and never fails on a mismatch — the mismatches ARE the documented gap (K21, M8).",
  "field_contract": {
    "id": "stable case id; referenced by docs/backlog/command-gate-shell-evasion/README.md",
    "command": "raw command string, exactly as a hook would receive it in tool_input.command",
    "should_gate": "true when the shell executes a gated action; false when nothing gated executes",
    "expected_rule": "the rule that OUGHT to decide this case; '(none)' when nothing should match; '(no shipped rule)' when the action is gate-worthy but no rule covers the binary",
    "expected_actions": "approval actions a correct gate would require; [] for deny-stage rules and for true negatives",
    "evasion_class": "member of evasion_classes",
    "red_arm": "the forbidden narrowing (N1..N6 in the ticket README) this case must stay RED against; '' when none",
    "source": "review | prerelease-report | repo-docs:<file>:<line> | constructed",
    "why": "one line: what the shell actually does"
  },
  "evasion_classes": {
    "plain": "No obfuscation. Baseline true positives, compound-list position, and ordinary developer lines.",
    "quote-splitting": "Quote or backslash fragmentation of a token the shell reassembles (de'pl'oy, mi\"grate\", \\rm).",
    "dynamic-construction": "The gated token never appears literally: eval, command substitution, variables, aliases, sourced scripts, package scripts.",
    "whitespace": "Separator form: repeated spaces, tabs, line continuation, ${IFS}, and lookalike non-separators.",
    "path-form": "Same binary reached by another spelling of its path or launcher (/bin/rm, command, env, busybox, ./node_modules/.bin).",
    "comment-heredoc": "Text that is not executed (comments, data-only heredoc bodies) and heredoc bodies that ARE executed.",
    "encoding": "The gated token exists only after decoding (base64, \\x escapes, chr()).",
    "payload-context": "The gated text sits inside an argument payload (-m, -F, a grep pattern) — inert prose in one direction, an executing substitution in the other.",
    "alternate-binary": "A different program performs the same gated effect; no shipped rule names it. Not an evasion of the parser — a coverage gap the parser cannot close."
  },
  "class_note": "The six classes named in the T5 brief are quote-splitting, dynamic-construction, whitespace, path-form, comment-heredoc, encoding. `plain`, `payload-context` and `alternate-binary` are added because true negatives, the false-positive direction, and rule-coverage gaps have no home among the six.",
  "red_arms": {
    "N1": "anchor destructive patterns to the start of the command string",
    "N2": "strip / ignore the -m payload before matching",
    "N3": "strip / ignore the -F <file> payload",
    "N4": "ignore heredoc bodies",
    "N5": "split argv and inspect tokens",
    "N6": "ship 'phase 1 = FP fix, phase 2 = parser'"
  },
